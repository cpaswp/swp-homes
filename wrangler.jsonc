{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swp-homes",
  "main": "index.py",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "python_modules": {
    "exclude": [
      "**/*.pyc",
      "**/__pycache__/**",
      "**/tests/**",
      "**/test/**",
      "**/test_*.py",
      "**/*_test.py",
      "**/*_tests.py",
      "**/*.pyi",
      "**/docs/**",
      "**/examples/**"
    ]
  }
}
